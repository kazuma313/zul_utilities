# Salin file ini menjadi .env, lalu isi nilainya di .env.
# .env ada di .gitignore, jadi isinya tidak ikut ter-push. File ini hanya berisi nama variabel.

# Kunci API Anthropic, untuk mencoba model Claude.
ANTHROPIC_API_KEY=

# Kunci Supadata, dipakai skill youtube_transcript saat YouTube memblokir IP ini (daftar di supadata.ai).
SUPADATA_API_KEY=

# Model yang membaca gambar dan PDF hasil scan untuk skill silabus_belajar dan materi_belajar.
# Kosong: gemma3:4b di Ollama lokal. Contoh model lokal: glm-ocr, qwen3-vl:4b.
# Contoh model yang di-deploy dengan vLLM: READER_API=openai, READER_BASE_URL=https://HOST/v1,
# READER_MODEL=PaddlePaddle/PaddleOCR-VL-1.6.
READER_MODEL=
READER_API=
READER_BASE_URL=
READER_API_KEY=
# Prompt pembaca. Kosong: dipilih sesuai model (glm-ocr, PaddleOCR-VL, dan DeepSeek-OCR punya prompt sendiri).
READER_PROMPT=
