       "width": {
        "enum": [
         "narrow",
         "half",
         "wide",
         "full"
        ]
       },
       "icon": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "title",
       "items"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "properties": {
       "type": {
        "const": "facts"
       },
       "title": {
        "type": "string"
       },
       "items": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "label": {
           "type": "string"
          },
          "value": {
