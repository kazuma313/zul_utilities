         "type": "object",
         "properties": {
          "title": {
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "icon": {
           "type": "string"
          }
         },
         "required": [
          "title",
          "text"
         ],
         "additionalProperties": false
        },
        "minItems": 2,
        "maxItems": 4
