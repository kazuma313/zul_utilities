{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "research poster",
 "description": "All 6 section types. For structured output / guided decoding (Ollama `format`, LM Studio / llama.cpp / vLLM `response_format`). No $ref on purpose.",
 "type": "object",
 "properties": {
  "tag": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "highlight": {
   "type": "string"
  },
  "subtitle": {
   "type": "string"
  },
  "footer": {
