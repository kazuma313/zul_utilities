         "type": "object",
         "properties": {
          "title": {
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "icon": {
           "type": "string"
          }
         },
         "required": [
          "title",
          "text"
         ],
         "additionalProperties": false
        }
       },
       "width": {
        "enum": [
         "narrow",
         "half",
         "wide",
         "full"
        ]
       },
       "icon": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "title",
       "items"
      ],
      "additionalProperties": false
