  "lead": {
   "type": "string"
  },
  "theme": {
   "enum": [
    "blue",
    "purple"
   ]
  }
 },
 "required": [
  "tag",
  "title",
  "subtitle",
  "footer",
  "sections"
 ],
 "additionalProperties": false
}