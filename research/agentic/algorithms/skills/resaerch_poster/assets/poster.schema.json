       "width": {
        "enum": [
         "narrow",
         "half",
         "wide",
         "full"
        ]
       },
       "icon": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "title",
       "chart",
       "text"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "properties": {
       "type": {
        "const": "columns"
