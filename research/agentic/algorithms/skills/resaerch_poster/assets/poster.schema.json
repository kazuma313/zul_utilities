      "type": "object",
      "properties": {
       "type": {
        "const": "chart"
       },
       "title": {
        "type": "string"
       },
       "chart": {
        "type": "object",
        "properties": {
         "type": {
          "enum": [
           "donut",
           "pie",
           "column",
           "bar",
           "line"
