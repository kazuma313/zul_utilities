     {
      "type": "object",
      "properties": {
       "type": {
        "const": "stats"
       },
       "title": {
        "type": "string"
       },
       "items": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "label": {
           "type": "string"
          },
          "value": {
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "icon": {
           "type": "string"
          }
         },
         "required": [
          "label",
          "value",
          "text"
         ],
         "additionalProperties": false
        },
        "minItems": 2,
        "maxItems": 5
       },
       "width": {
        "enum": [
         "narrow",
         "half",
         "wide",
         "full"
        ]
       },
       "icon": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "title",
       "items"
      ],
      "additionalProperties": false
     },
